# Load ALWAYS_ENABLED_INFRA from project.json (falls back to defaults if not specified)
ALWAYS_ENABLED_INFRA = {{starlarkArray alwaysEnabledInfra}}

def should_enable(resource_name):
    if FOCUS_MODE and resource_name in ALWAYS_ENABLED_INFRA:
        return RESOURCE_DEFAULTS.get(resource_name, True)
    if FOCUS_MODE and FOCUS_ENABLED_ALL:
        if resource_name in FOCUS_ENABLED_ALL:
            return True
        for domain in FOCUS_ENABLED_ALL:
            if resource_name.startswith(domain + "-"):
                return True
    return Utils.should_enable(resource_name, cfg, RESOURCE_DEFAULTS)

