        discovery_path = _local_tdk_path + "/discovery"
    else:
        discovery_path = str(local("echo $HOME/Library/Application Support/tilt-dev/tilt_modules/github.com/tdk-landscape/tdk-cli/discovery", quiet=True)).strip()
        if str(local('uname -s', quiet=True)).strip() == 'Linux':
            discovery_path = str(local("echo $HOME/.local/share/tilt-dev/tilt_modules/github.com/tdk-landscape/tdk-cli/discovery", quiet=True)).strip()

    daemon_script = discovery_path + '/resource_snapshot.py'
    daemon_cmd = "cd " + config.main_dir + " && python3 \"" + daemon_script + "\" watch"
    
    local_resource('service-discovery-daemon',
        serve_cmd=daemon_cmd,
        deps=[daemon_script],
        auto_init=True, labels=['discovery'],
        links=[link('file:///snapshots/resource-snapshot.json', 'Resource Snapshot')]
    )
    


