    environment:
        - VITE_APP_ENV=development
    labels:
        - "traefik.enable=true"
        - 'traefik.http.routers.identity-management-frontend.rule=Host(`identity-management-frontend.localhost`) || (Host(`beauty-crm.localhost`) && PathPrefix(`/identity-management`)) || (Host(`localhost`) && PathPrefix(`/identity-management`))'
        - "traefik.http.routers.identity-management-frontend.entrypoints=web,websecure"
        - "traefik.http.routers.identity-management-frontend.priority=120"
        - "traefik.http.routers.identity-management-frontend.middlewares=identity-management-frontend-stripprefix"
        - "traefik.http.middlewares.identity-management-frontend-stripprefix.stripprefix.prefixes=/identity-management"
        - "traefik.http.services.identity-management-frontend.loadbalancer.server.port=3000"
