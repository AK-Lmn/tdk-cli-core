x-nix-any-m1-arm64-memory-limit: &nix-any-m1-arm64-memory-limit
  deploy:
    resources:
      limits:
        memory: 192M
      reservations:
        memory: 64M

x-frontend-memory-limit: &frontend-memory-limit
  deploy:
    resources:
      limits:
        memory: 64M
        cpus: '0.15'
      reservations:
        memory: 32M

services:
  identity-sdk:
    image: identity_identity-sdk:dev
    build:
      context: ../../../../.
      dockerfile: services/product/identity/identity-sdk/autogenerated/Dockerfile.app.autogenerated
      target: production
    <<: *frontend-memory-limit
    env_file:
      - ../identity-sdk/autogenerated/.env.frontend.autogenerated
    environment:
        - VITE_APP_ENV=development
    labels:
        - "traefik.enable=true"
        - 'traefik.http.routers.identity-sdk.rule=Host(`identity-sdk.localhost`) || (Host(`beauty-crm.localhost`) && PathPrefix(`/identity-sdk`)) || (Host(`localhost`) && PathPrefix(`/identity-sdk`))'
        - "traefik.http.routers.identity-sdk.entrypoints=web,websecure"
        - "traefik.http.routers.identity-sdk.priority=113"
        - "traefik.http.routers.identity-sdk.middlewares=identity-sdk-stripprefix"
        - "traefik.http.middlewares.identity-sdk-stripprefix.stripprefix.prefixes=/identity-sdk"
        - "traefik.http.services.identity-sdk.loadbalancer.server.port=3000"
        - "traefik.docker.network=beauty_crm_traefik-public"
    networks:
        - beauty_crm_traefik-public
        - beauty_crm_backend
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1:80"]
      interval: 10s
      timeout: 5s
      retries: 3
      # STORY 4 FIX: 30s grace period to prevent 504 errors on startup
      start_period: 30s


  identity-management-backend:
    image: identity_identity-management-backend:dev
    restart: unless-stopped
    build:
      context: ../../../../.
      dockerfile: services/product/identity/identity-management-backend/autogenerated/Dockerfile.app.autogenerated

    env_file:
      - ../identity-management-backend/autogenerated/.env.backend.autogenerated
    environment:
      - INFISICAL_CLIENT_ID=${INFISICAL_CLIENT_ID:-local-dev-client-id}
      - INFISICAL_CLIENT_SECRET=${INFISICAL_CLIENT_SECRET:-local-dev-client-secret}
      - INFISICAL_PROJECT_ID=${INFISICAL_PROJECT_ID:-local-dev-project-id}
      - INFISICAL_SITE_URL=${INFISICAL_SITE_URL:-http://beauty_crm-infisical:8080}
      - INFISICAL_ENV=${INFISICAL_ENV:-dev}
      - INFISICAL_ENABLED=${INFISICAL_ENABLED:-true}
      - SERVICE_NAME=identity
      - PORT=3000
      - INSTANCE_ID=0
      - NATS_QUEUE_GROUP=identity_backend_svc
      - TILT_DATABASE_URL=postgresql://beauty_crm:${DB_PASSWORD}@beauty_crm_postgres:5432/beauty_crm_identity?schema=public
      - TILT_NATS_URL=nats://beauty_crm_nats:4222
      - NODE_ENV=development
      - DATABASE_URL=postgresql://beauty_crm:${DB_PASSWORD}@beauty_crm_postgres:5432/beauty_crm_identity?schema=public
      - AUTH_MODE=identity-service
      - IDENTITY_SERVICE_URL=${IDENTITY_SERVICE_URL:-None}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.identity-management-backend.rule=Host(`identity.backend.beauty.local`) || PathPrefix(``)"
      - "traefik.http.routers.identity-management-backend.entrypoints=web"
      - "traefik.http.routers.identity-management-backend.service=identity-management-backend"
      - "traefik.http.routers.identity-management-backend.middlewares=identity-management-backend-stripprefix"
      - "traefik.http.middlewares.identity-management-backend-stripprefix.stripprefix.prefixes="
      - "traefik.http.services.identity-management-backend.loadbalancer.server.port=3000"
      - "traefik.http.services.identity-management-backend.loadbalancer.healthcheck.path=/health"
      - "traefik.http.services.identity-management-backend.loadbalancer.healthcheck.interval=15s"
      - "traefik.http.services.identity-management-backend.loadbalancer.healthcheck.timeout=10s"
      - "traefik.http.services.identity-management-backend.loadbalancer.healthcheck.followredirects=false"
      - "traefik.docker.network=beauty_crm_traefik-public"

      - "traefik.http.routers.identity-management-backend-beauty-crm.rule=Host(`beauty-crm.localhost`) && PathPrefix(`/api/v1/identity`)"
      - "traefik.http.routers.identity-management-backend-beauty-crm.entrypoints=web"
      - "traefik.http.routers.identity-management-backend-beauty-crm.service=identity-management-backend"
      - "traefik.http.routers.identity-management-backend-beauty-crm.middlewares=identity-management-backend-stripprefix-beauty-crm"
      - "traefik.http.middlewares.identity-management-backend-stripprefix-beauty-crm.stripprefix.prefixes=/api/v1/identity"
      - "traefik.http.routers.identity-management-backend-beauty-crm.priority=116"

    networks:
      - beauty_crm_traefik-public
      - beauty_crm_backend
      - beauty_crm_database
      - beauty_crm_infisical-network
    healthcheck:
      test: ["CMD", "curl", "-f", "--max-time", "5", "http://localhost:3000/health"]
      interval: 10s
      timeout: 5s
      retries: 6
      # STORY 4 FIX: 30s grace period to prevent 504 errors during startup
      # Services get 30s to initialize before health checks begin
      start_period: 30s
    # Note: depends_on removed - Tilt manages service startup order
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
        reservations:
          cpus: '0.2'
          memory: 256M

  identity-management-frontend:
    image: identity_identity-management-frontend:dev
    build:
      context: ../../../../.
      dockerfile: services/product/identity/identity-management-frontend/autogenerated/Dockerfile.app.autogenerated
      target: production
    <<: *frontend-memory-limit
    env_file:
